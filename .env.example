# Vite exposes env vars prefixed with VITE_ to the browser bundle.
# Copy this file to .env.local and fill in real values for local development.
# In Vercel, add these under Project Settings > Environment Variables.

VITE_API_BASE_URL=https://api.example.com
VITE_API_BEARER_TOKEN=your-bearer-token-here
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_TURNSTILE_SITE_KEY=0x00000000000000000000FF
VITE_ENABLE_COMMUNITY_SENTIMENT=false

# Server-only vars for the Vercel functions under api/. Do NOT prefix these with
# VITE_, or Vite inlines them into the browser bundle. Set them in .env.local for
# `vercel dev`, and in Vercel Project Settings > Environment Variables for deploy.
# The agent function also reads VITE_API_BASE_URL above to reach the backend.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Read-only backend bot token (the `bot` role with `worlds:query`), never a
# curator token. The agent function uses it for catalog reads and for
# POST /api/worlds/query; it never holds worlds:write.
AGENT_WORLDS_API_TOKEN=your-backend-bot-token
# Optional. Defaults to gemini-3.5-flash when unset.
AGENT_GEMINI_MODEL=gemini-3.5-flash
