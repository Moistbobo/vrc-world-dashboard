# Next.js exposes env vars prefixed with NEXT_PUBLIC_ to the browser bundle.
# Copy this file to .env.local and fill in real values for local development.
# In Vercel, add these under Project Settings > Environment Variables.

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BEARER_TOKEN=your-bearer-token-here
# Server-only read token for server components; never sent to the browser.
API_BASE_URL=https://api.example.com
API_BEARER_TOKEN=your-bearer-token-here
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x00000000000000000000FF
NEXT_PUBLIC_ENABLE_COMMUNITY_SENTIMENT=false
